# DECISION_LOG.md is append-only: every branch prepends a new entry at the
# same anchor (immediately under the file header), so any two branches open
# at the same time conflict there even though neither touched the other's
# text. The union driver keeps both sides' lines instead, which is the
# correct resolution for this file by construction — an entry is never
# edited or removed once written, only added.
#
# Entry ordering after a union merge follows whichever side git emits first
# and is not guaranteed to be reverse-chronological. That is acceptable
# here: each entry is self-dating in its own heading, so ordering is a
# presentation detail, not information. Resort by hand if it drifts.
DECISION_LOG.md merge=union

# Same reasoning for the machine-written promotion log, if one is ever
# committed (it is gitignored by default — see storage.decision_log_path).
logs/decision_log.md merge=union

# Generated by detect-secrets on every commit; its `generated_at` timestamp
# and the line numbers of already-audited findings churn constantly, so it
# conflicts on essentially every parallel branch. Union is NOT safe here —
# it is JSON and would produce a syntactically invalid file. Resolve by
# taking either side and re-running the hook, which rewrites it wholesale:
#
#     git checkout --theirs .secrets.baseline && pre-commit run detect-secrets
#
# Marked as generated so review tooling collapses it by default.
.secrets.baseline linguist-generated=true
