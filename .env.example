# .env.example — Combined example (exchange, API, intelligence)
# Placeholders only. DO NOT commit real secrets. Use a secret manager for production.

# ----------------------------
# Exchange credentials (examples)
# ----------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# ----------------------------
# Application runtime & API
# ----------------------------
# Required: set strong random secrets before starting (e.g. openssl rand -hex 32)
API_SECRET_KEY=
OPERATOR_SECRET=
TRADING_MODE=paper                # paper | live
EXECUTION_MODE=automatic         # automatic | manual
DASHBOARD_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
SENTRY_DSN=

# ----------------------------
# Order / execution throttles and limits
# ----------------------------
ORDER_THROTTLE_MAX_ORDERS_PER_MIN=10
ORDER_THROTTLE_MIN_INTERVAL_MS=500

# ----------------------------
# Storage / persistence
# ----------------------------
STORAGE_BACKEND=sqlite            # sqlite | timescale | s3
STORAGE_DB_PATH=./data/trade_bot.db
STORAGE_WAL_PATH=./data/journal.wal
STORAGE_TIMESCALE_DSN=postgresql://user:pass@host:5432/dbname
S3_BUCKET_NAME=
S3_ENDPOINT=

# ----------------------------
# Intelligence / predictor providers (placeholders)
# ----------------------------
INTELLIGENCE_GLASSNODE_API_KEY=
INTELLIGENCE_CRYPTOQUANT_API_KEY=
INTELLIGENCE_ARKHAM_API_KEY=
INTELLIGENCE_DUNE_API_KEY=
INTELLIGENCE_COINGLASS_API_KEY=
INTELLIGENCE_DEFILLAMA_API_KEY=

# Intelligence provider tuning (seconds)
INTELLIGENCE_CACHE_TTL_ONCHAIN_SECONDS=3600
INTELLIGENCE_CACHE_TTL_EXCHANGE_SECONDS=300
INTELLIGENCE_GLASSNODE_RATE_LIMIT_SECONDS=1.0
INTELLIGENCE_ARKHAM_CACHE_TTL_S=60
INTELLIGENCE_DEFILLAMA_CACHE_TTL_S=300
INTELLIGENCE_DUNE_CACHE_TTL_S=3600
INTELLIGENCE_COINGLASS_CACHE_TTL_S=30

# Optional intelligence feature toggles
INTELLIGENCE_ENABLE_ONCHAIN=true
INTELLIGENCE_ENABLE_EXCHANGE=true
INTELLIGENCE_USE_ENSEMBLE_PREDICTOR=true

# ----------------------------
# Exchange overrides / endpoints
# ----------------------------
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
OKX_BASE_URL=
OKX_WS_URL=
BYBIT_BASE_URL=

# ----------------------------
# Feature flags & behavior
# ----------------------------
FEATURE_BACKFILL_ON_START=false
FEATURE_SELF_TUNING=false

# ----------------------------
# Monitoring & observability
# ----------------------------
METRICS_PUSHGATEWAY_URL=
PROMETHEUS_ENABLED=true

# ----------------------------
# Developer / local testing helpers (placeholders)
# ----------------------------
DEV_SEED_DATA_PATH=./data/sample_seed.csv
LOCAL_MODE=true

# ----------------------------
# Notes:
# - Do NOT commit real credentials. Use a secrets manager (Vault, AWS Secrets Manager, etc.).
# - The application uses Pydantic Settings with env_prefix groups (see src/config.py).
#   INTELLIGENCE_* keys map to IntelligenceSettings; STORAGE_* map to StorageSettings.
# - Providers tolerate empty keys in fail-open intelligence adapters, but paid providers
#   require valid keys for full coverage/backfill.
# - Tailor these placeholders to your deployment environment and keep secrets out of
#   source control.
