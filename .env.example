# ============================================================================
# Trade-Bot environment template.
#
# Copy to `.env` and fill in secrets. Every variable is optional at import time
# (src/config.py supplies defaults), but the ones flagged REQUIRED below must
# be set for the corresponding subsystem to function.
#
# 13 prefix groups, one class per group in src/config.py.
# ============================================================================

# ---- BINANCE_ (primary exchange) ------------------------------------------
# REQUIRED for live/paper trading against Binance.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# Only set BASE_URL / WS_URL to override the auto-selected testnet/prod URLs.
# BINANCE_BASE_URL=
# BINANCE_WS_URL=
BINANCE_RATE_LIMIT_PER_MINUTE=1200

# ---- OKX_ (secondary exchange) --------------------------------------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
OKX_TESTNET=true
OKX_BASE_URL=https://www.okx.com
OKX_RATE_LIMIT_PER_SECOND=10

# ---- RISK_ (hard risk limits — never weakened at runtime) -----------------
# See docs/security and src/risk/. Units differ by field; read src/config.py.
RISK_DAILY_DRAWDOWN_HALT_PCT=2.0
RISK_CONSECUTIVE_LOSS_HALT=3
RISK_MAX_POSITION_SIZE_PCT=5.0
RISK_CAPITAL_PRESERVATION_MAX_DRAWDOWN_PCT=0.30
RISK_KELLY_MULTIPLIER=0.5
RISK_KELLY_CEILING=0.25
RISK_OOS_SHARPE_THRESHOLD=1.5
RISK_MAX_DRAWDOWN_THRESHOLD=15.0
RISK_MIN_TRADES_LIVE_GATE=500

# ---- HMM_ / XGB_ (regime + ML model tuning) -------------------------------
# HMM_N_STATES=...
# XGB_MAX_DEPTH=...

# ---- FEATURE_ (feature engineering) ---------------------------------------
# FEATURE_WINDOW=...

# ---- STORAGE_ (persistence backend) ---------------------------------------
# "sqlite" for dev; "timescale" for the local TimescaleDB container.
STORAGE_BACKEND=sqlite
STORAGE_TIMESCALE_DSN=postgresql://tradebot:tradebot-local@timescaledb:5432/tradebot
STORAGE_DB_PATH=data/trade_bot.db
STORAGE_MODEL_DIR=models/artifacts
STORAGE_LOG_DIR=logs
STORAGE_BAR_CACHE_DAYS=90
STORAGE_DECISION_LOG_PATH=logs/AUTOMATED_DECISION_LOG.md

# ---- API_ (FastAPI server) ------------------------------------------------
# Default 127.0.0.1 is loopback-only; the lifespan validator refuses to bind
# a non-loopback host without an explicit acknowledgement.
API_HOST=127.0.0.1
API_PORT=8000
API_RELOAD=false
API_CORS_ORIGINS=["http://localhost:5173"]
API_WS_HEARTBEAT_S=5.0

# ---- INTELLIGENCE_ (on-chain providers) -----------------------------------
# Empty keys => client logs a warning and uses safe fallbacks.
INTELLIGENCE_GLASSNODE_API_KEY=
INTELLIGENCE_CRYPTOQUANT_API_KEY=

# ---- SELF_TUNING_ ---------------------------------------------------------
# SELF_TUNING_ENABLED=false

# ---- STRATEGY_ / STRATEGY_ (portfolio + strategy tuning) ------------------
# STRATEGY_...

# ---- ORDER_THROTTLE_ ------------------------------------------------------
# ORDER_THROTTLE_MAX_ORDERS_PER_MINUTE=...

# ---- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
LOG_AS_JSON=false
