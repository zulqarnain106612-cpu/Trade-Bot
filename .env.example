BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
# Required: set a strong random secret before starting (e.g. openssl rand -hex 32)
API_SECRET_KEY=
# M-05/H-01: Required for /execution-mode endpoint (openssl rand -hex 32)
OPERATOR_SECRET=
TRADING_MODE=paper
DASHBOARD_PORT=8000
FRONTEND_PORT=5173
LOG_LEVEL=INFO
DB_PATH=./data/tradebot.db
WAL_PATH=./data/journal.wal


# GAP-015: Glassnode (Professional plan, https://studio.glassnode.com/pricing)
# + CryptoQuant API keys. Required only for the 15-feature intelligence
# layer (src/features/intelligence_features.py) and historical backfill.
# Leave blank to run with intelligence gates fail-open (current default).
INTELLIGENCE_GLASSNODE_API_KEY=
INTELLIGENCE_CRYPTOQUANT_API_KEY=

# OCI-001: Free-tier on-chain providers (no paid plan required)
# Arkham Intel: https://intel.arkm.com/api — free, register for key
INTELLIGENCE_ARKHAM_API_KEY=
# Dune Analytics: https://dune.com — free tier, get key at dune.com/settings/api
INTELLIGENCE_DUNE_API_KEY=
# Coinglass: https://coinglass.com — free tier, register for key
INTELLIGENCE_COINGLASS_API_KEY=
# DeFiLlama: no key required (public API)
