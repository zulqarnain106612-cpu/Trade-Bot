.project-intel/RAW_SCAN.json
.project-intel/.session_marker
.project-intel/.active_session_context
.project-intel/archive/

# Installer artifacts (never in project root)
trade-bot-intel-system/
trade-bot-intel-system.tar.gz

# Stray debug output files
*.full.txt
tmp_out.txt
temp_*.txt

# Test coverage
.coverage
htmlcov/

# RAG index — rebuilt automatically, don't track binary
.project-intel/rag.db

# Knowledge base — DO track (source of truth for domain knowledge)
!.project-intel/knowledge/

# GAP-010: model binaries and logs — never commit (matches .claudeignore)
/models/
/logs/
*.pkl
*.joblib
*.log

# Debt-002: pytest-cov artifact
.coverage
coverage.xml
coverage.json
cov_debug_out*.json
htmlcov/

# Intel daemon runtime files (never track)
.project-intel/daemon.pid
.project-intel/rag.db-journal
.claude/review-queue.log

# Auto-rewritten by .git/hooks/post-commit after every commit (handoff.py
# checkpoint) — never converges to a clean tree if tracked. Runtime session
# state, not source, same category as daemon.pid/rag.db above.
.project-intel/HANDOFF.md
.project-intel/SESSION_STATE.json
