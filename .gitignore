__pycache__/
*.pyc
.venv/
.env
# A bare `.env` matches that one name and nothing else, so every neighbour of
# it stayed committable -- `.env.bak.<timestamp>` from a backup-before-edit,
# `.env.local`, `.env.save`. Each holds the same API_SECRET_KEY and
# OPERATOR_SECRET as the original, so ignoring only `.env` protected the
# filename rather than the secret. `.env.example` is excluded below because it
# is the checked-in, secret-free template.
.env.*
!.env.example
.coverage
# coverage.py's parallel mode, which the suite runs in under xdist, writes
# one data file per worker suffixed with host and pid (.coverage.vm.pid740.*),
# and CI writes .coverage.shard-N. Bare `.coverage` matches none of them, so a
# local `pytest -n auto` left a pile of untracked files behind that look like
# repository content in `git status`.
.coverage.*
htmlcov/
# Anchored to the repository root. Unanchored, `data/` matched `src/data/`
# too -- which silently kept src/data/clock.py out of the repository while it
# sat on disk looking committed, and left the quality registry naming an
# owning module CI could not find.
/data/
logs/

node_modules/
frontend/dist/
frontend/release/

# Editable-install metadata, regenerated by any `pip install -e .`
*.egg-info/
.aider*

# Created at runtime by StorageSettings.model_dir the first time a model is
# registered, which any suite run does. Artifacts, not source.
models/
