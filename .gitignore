__pycache__/
*.pyc
.venv/
.env
# Vite reads .env.local / .env.<mode>.local for local overrides, and the
# dashboard's VITE_API_KEY lives there. A bare `.env` pattern does not
# match those names, so they need their own entries or a dev API key ends
# up committed.
.env.local
.env.*.local
# Timestamped backups taken before editing .env. They contain the same
# API_SECRET_KEY / OPERATOR_SECRET as the original, so a bare `.env` pattern
# leaving these tracked would defeat the point of ignoring `.env` at all.
.env.bak*
.coverage
htmlcov/
data/
logs/

node_modules/
frontend/dist/
frontend/release/

# Editable-install metadata, regenerated by any `pip install -e .`
*.egg-info/
.aider*

# pip build scratch — /tmp is a 1.4G tmpfs here, so TMPDIR is redirected
# into the repo when installing torch and friends.
.venv-tmp/
