{
  "version": "2.0.0",
  "tasks": [
    // ── Frontend ─────────────────────────────────────────────────────────────
    {
      "label": "Frontend: Run Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },

    // ── Auto-commit & Push (Ctrl+Shift+S) ────────────────────────────────────
    {
      "label": "Auto-commit & Push",
      "type": "shell",
      "command": "bash scripts/autocommit.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": [],
      "group": "none",
      "runOptions": { "instanceLimit": 1 }
    },

    // ── Auto-commit dry-run ───────────────────────────────────────────────────
    {
      "label": "Auto-commit: Dry Run",
      "type": "shell",
      "command": "bash scripts/autocommit.sh --check",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    },

    // ── Auto-fix all ─────────────────────────────────────────────────────────
    {
      "label": "Auto-fix All",
      "type": "shell",
      "command": "bash scripts/autofix.sh",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": [],
      "group": "test"
    },

    // ── Run tests ─────────────────────────────────────────────────────────────
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python -m pytest tests/ -v --tb=short",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },

    // ── Security scan ─────────────────────────────────────────────────────────
    {
      "label": "Security Scan",
      "type": "shell",
      "command": "bash -c 'bandit -r src/ --severity-level medium -q && echo CLEAN || echo ISSUES FOUND'",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "always", "panel": "shared" },
      "problemMatcher": []
    }
  ]
}
