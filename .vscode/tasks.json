{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Frontend: Run Vite",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": [],
      "group": "build"
    },
    {
      "label": "Commit (no push)",
      "type": "shell",
      "command": "bash scripts/autocommit.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "focus": false,
        "clear": true
      },
      "problemMatcher": [],
      "group": "none",
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Auto-commit: Dry Run",
      "type": "shell",
      "command": "bash scripts/autocommit.sh --check",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "Auto-fix All",
      "type": "shell",
      "command": "bash scripts/autofix.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "Run Tests",
      "type": "shell",
      "command": "python3 -m pytest tests/ -v --tb=short",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    },
    {
      "label": "Security Scan",
      "type": "shell",
      "command": "bash -c 'bandit -r src/ --severity-level medium -q && echo CLEAN || echo ISSUES FOUND'",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ]
}