// ════════════════════════════════════════════════════════════════════════════
// ZERO AUTO-EXECUTION POLICY — ENFORCED
// Authorized writers: User (human) + CLAUDE-MAIN-AGENT only
// Identity token: CLAUDE_MAIN_AGENT_v1 (see .vscode/AGENT_IDENTITY.md)
// All auto-commits, auto-push, auto-fetch, auto-hooks, auto-activation,
// auto-session, auto-context-primer, auto-fix, auto-format-on-type KILLED.
// ════════════════════════════════════════════════════════════════════════════

{
  // ── FORMATTER AUTHORITY ───────────────────────────────────────────────────
  //   Python  → charliermarsh.ruff
  //   JS/JSX/JSON/YAML/CSS/MD → esbenp.prettier-vscode

  // ── Global editor ─────────────────────────────────────────────────────────
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "editor.formatOnType": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.rulers": [100],
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.codeActionsOnSave": {
    "source.fixAll": "never"
  },

  // ── Python — RUFF ONLY ────────────────────────────────────────────────────
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.eslint": "never",
      "source.fixAll": "never"
    }
  },

  "python.formatting.provider": "none",
  "python.linting.enabled": false,
  "python.linting.flake8Enabled": false,
  "python.linting.pylintEnabled": false,
  "python.linting.mypyEnabled": false,
  "python.linting.banditEnabled": false,
  "python.linting.pycodestyleEnabled": false,
  "python.linting.pydocstyleEnabled": false,

  // ── Python interpreter — MANUAL ONLY, zero auto-activation ───────────────
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": false,
  "python.terminal.activateEnvInCurrentTerminal": false,
  "python.interpreter.infoVisibility": "never",

  // ── Ruff ─────────────────────────────────────────────────────────────────
  "ruff.enable": true,
  "ruff.lint.enable": true,
  "ruff.format.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ruff.showNotifications": "onWarning",
  "ruff.configurationPreference": "filesystemFirst",

  // ── Pylance — type analysis only, no formatting, no auto-import exec ──────
  "python.languageServer": "Pylance",
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.useLibraryCodeForTypes": true,
  "python.analysis.autoImportCompletions": false,
  "python.analysis.indexing": false,
  "python.analysis.diagnosticMode": "workspace",
  "python.analysis.ignore": ["**/frontend/**", "**/.venv/**", "**/dist/**"],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportMissingTypeStubs": "none",
    "reportMissingImports": "none",
    "reportMissingModuleSource": "none",
    "reportUnknownVariableType": "none",
    "reportUnknownMemberType": "none",
    "reportUnknownArgumentType": "none",
    "reportUnknownParameterType": "none",
    "reportPrivateUsage": "none",
    "reportAttributeAccessIssue": "none",
    "reportReturnType": "none",
    "reportArgumentType": "none",
    "reportOperatorIssue": "none",
    "reportIndexIssue": "none",
    "reportCallIssue": "none",
    "reportOptionalMemberAccess": "none",
    "reportOptionalCall": "none",
    "reportOptionalIterable": "none",
    "reportGeneralTypeIssues": "none",
    "reportUntypedFunctionDecorator": "none",
    "reportUntypedClassDecorator": "none",
    "reportUntypedBaseClass": "none",
    "reportPrivateImportUsage": "none",
    "reportConstantRedefinition": "none",
    "reportIncompatibleMethodOverride": "none",
    "reportIncompatibleVariableOverride": "none",
    "reportPossiblyUnbound": "warning",
    "reportUninitializedInstanceVariable": "warning",
    "reportUnusedCoroutine": "error"
  },

  // ── Tests ─────────────────────────────────────────────────────────────────
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests", "-v", "--tb=short"],
  "python.testing.autoTestDiscoverOnSaveEnabled": false,

  // ── JavaScript/JSX ────────────────────────────────────────────────────────
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "never"
    }
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit",
      "source.fixAll": "never"
    }
  },

  "eslint.enable": true,
  "eslint.format.enable": false,
  "eslint.workingDirectories": [{ "directory": "frontend", "changeProcessCWD": true }],
  "eslint.validate": ["javascript", "javascriptreact"],
  "eslint.run": "onSave",

  "prettier.enable": true,
  "prettier.requireConfig": true,
  "prettier.configPath": "${workspaceFolder}/frontend/.prettierrc",

  // ── JSON/JSONC/YAML/TOML/Markdown ─────────────────────────────────────────
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 2
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.wordWrap": "on"
  },

  // ── Git — ZERO AUTO-COMMIT / ZERO AUTO-PUSH / ZERO AUTO-FETCH ────────────
  // KILLED: git.enableSmartCommit (was true — auto-stages all tracked files)
  // KILLED: git.autofetch (was true — background network polling)
  // KILLED: git.postCommitCommand: "push" (was auto-pushing every commit)
  // KILLED: git.confirmSync: false (was syncing without confirmation)
  "git.enableSmartCommit": false,
  "git.autofetch": false,
  "git.postCommitCommand": "none",
  "git.confirmSync": true,
  "git.autoStash": false,
  "git.pruneOnFetch": false,
  "git.fetchOnPull": false,
  "git.autoRepositoryDetection": false,
  "git.enabled": true,

  // ── GitHub Copilot — ZERO AUTO-INSTRUCTION-FILE READING ──────────────────
  // KILLED: useInstructionFiles (was auto-reading .github/copilot-instructions.md)
  // KILLED: reviewSelection.enabled auto-trigger
  // CONTEXT_PRIMER reference removed from reviewSelection.instructions
  "github.copilot.enable": {
    "*": true,
    "python": true,
    "yaml": true,
    "json": true,
    "markdown": true,
    "plaintext": false
  },
  "github.copilot.editor.enableAutoCompletions": true,
  "github.copilot.chat.localeOverride": "en",
  "github.copilot.chat.codeGeneration.useInstructionFiles": false,
  "github.copilot.chat.reviewSelection.enabled": false,
  "github.copilot.chat.codeGeneration.instructions": [],
  "github.copilot.chat.commitMessageGeneration.instructions": [
    {
      "text": "Use conventional commits: type(scope): description. Types: feat fix refactor chore docs test security perf. Max 72 chars. NEVER auto-push. NEVER auto-commit. Human commits manually only."
    }
  ],
  "github.copilot.chat.reviewSelection.instructions": [],
  "github.copilot.chat.testGeneration.instructions": [
    {
      "text": "Follow tests/test_risk_gates.py patterns. Use pytest + pytest-asyncio. async def for all async tests. Parameterised SQL only. structlog not print(). Cover happy path + veto path for CognitiveEngine validators."
    }
  ],

  // ── Terminal — zero env inheritance, zero auto-shell-integration ──────────
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.env.linux": {},
  "terminal.integrated.env.osx": {},
  "terminal.integrated.env.windows": {},
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.enablePersistentSessions": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",

  // ── Claude Code — no auto terminal ───────────────────────────────────────
  "claudeCode.useTerminal": true,

  // ── Error Lens ────────────────────────────────────────────────────────────
  "errorLens.enabled": true,
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.followCursor": "allLines",
  "errorLens.delay": 300,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.messageMaxChars": 120,

  // ── SonarLint ─────────────────────────────────────────────────────────────
  "sonarlint.rules": {
    "python:S106":  { "level": "on" },
    "python:S105":  { "level": "on" },
    "python:S1313": { "level": "on" },
    "python:S4830": { "level": "on" },
    "python:S5527": { "level": "on" }
  },
  "sonarlint.disableTelemetry": true,

  // ── GitLens ───────────────────────────────────────────────────────────────
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.telemetry.enabled": false,

  // ── File handling ─────────────────────────────────────────────────────────
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/node_modules": true,
    "**/.ruff_cache": true,
    "**/.mypy_cache": true,
    "**/.trunk": false
  },
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/__pycache__/**": true,
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.mypy_cache/**": true
  },

  // ── Telemetry — ALL OFF ───────────────────────────────────────────────────
  "telemetry.telemetryLevel": "off",
  "redhat.telemetry.enabled": false,
  "workbench.enableExperiments": false,
  "workbench.settings.enableNaturalLanguageSearch": false,
  "extensions.autoCheckUpdates": false,
  "extensions.autoUpdate": false,
  "update.mode": "none",
  "update.showReleaseNotes": false,

  // ── YAML schemas ──────────────────────────────────────────────────────────
  "yaml.schemas": {
    "https://static.trunk.io/pub/trunk-yaml-schema.json": "file:///home/fujitsu/Projects/Trade-Bot-main/.trunk/trunk.yaml"
  },

  // ── Snyk ─────────────────────────────────────────────────────────────────
  "snyk.advanced.organization": "93a840a3-4866-4f81-bb0a-c5651baa370b",
  "snyk.advanced.autoSelectOrganization": false
}
