## ════════════════════════════════════════════════════════════════════════════
## TRADEBOT AUDITD RULES — Kernel-level syscall audit
## Place at: /etc/audit/rules.d/tradebot.rules
## Applied by: auditctl -R /etc/audit/rules.d/tradebot.rules
## View alerts: ausearch -k tradebot_write | aureport -f -i
## ════════════════════════════════════════════════════════════════════════════

## Delete existing rules first
-D

## Buffer size — increase for high-frequency projects
-b 8192

## Failure mode: 1=log, 2=panic
-f 1

## ── Watch project directory — ALL write/execute/attribute ops ────────────
## -p r = read, w = write, x = execute, a = attribute change
## We skip pure reads to avoid log flooding; writes and execs are the threat

-w /home/fujitsu/Projects/Trade-Bot-main/ -p wxa -k tradebot_write
-w /home/fujitsu/Projects/Trade-Bot-main/.git/ -p wxa -k tradebot_git
-w /home/fujitsu/Projects/Trade-Bot-main/.armor/ -p rwa -k tradebot_armor
-w /home/fujitsu/Projects/Trade-Bot-main/.vscode/ -p wxa -k tradebot_vscode

## ── Watch for autocommit/autofix scripts if they still exist ─────────────
-w /home/fujitsu/Projects/Trade-Bot-main/scripts/autocommit.sh -p rwxa -k tradebot_autocommit
-w /home/fujitsu/Projects/Trade-Bot-main/scripts/autofix.sh -p rwxa -k tradebot_autofix

## ── Git executable — log every git operation in the project ──────────────
-w /usr/bin/git -p x -k tradebot_git_exec

## ── Python interpreter — log every python execution touching project ──────
-a always,exit -F arch=b64 -S execve -F path=/usr/bin/python3 -F dir=/home/fujitsu/Projects/Trade-Bot-main -k tradebot_python_exec

## ── Shell — catch bash/sh executing inside project ───────────────────────
-a always,exit -F arch=b64 -S execve -F exe=/usr/bin/bash -F dir=/home/fujitsu/Projects/Trade-Bot-main -k tradebot_shell_exec

## ── Network — outbound connections from project processes ────────────────
-a always,exit -F arch=b64 -S connect -F dir=/home/fujitsu/Projects/Trade-Bot-main -k tradebot_network_out
-a always,exit -F arch=b64 -S sendto -F dir=/home/fujitsu/Projects/Trade-Bot-main -k tradebot_network_out

## ── Detect chmod/chown on project files (attacker covering tracks) ────────
-a always,exit -F arch=b64 -S chmod,fchmod,chown,fchown,lchown -F dir=/home/fujitsu/Projects/Trade-Bot-main -k tradebot_perm_change

## ── Detect unlink/rename (file deletion/replacement) ─────────────────────
-a always,exit -F arch=b64 -S unlink,unlinkat,rename,renameat -F dir=/home/fujitsu/Projects/Trade-Bot-main -k tradebot_delete

## Lock rules — prevent tampering with audit rules without reboot
## Uncomment only when you are sure rules are correct:
## -e 2
