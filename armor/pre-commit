#!/usr/bin/env bash
# ════════════════════════════════════════════════════════════════════════════
# GIT PRE-COMMIT HOOK — Zero auto-commit policy
# Authorized: HUMAN (interactive TTY) + CLAUDE_MAIN_AGENT_v1
# Blocks: any automated/non-interactive commit attempt
# ════════════════════════════════════════════════════════════════════════════
set -euo pipefail

AGENT_TOKEN="${CLAUDE_AGENT_IDENTITY:-}"
ARMOR_LOG="$(git rev-parse --show-toplevel)/.armor/alerts.log"
TS=$(date '+%Y-%m-%d %H:%M:%S.%3N')

log_alert() {
  local level="$1" msg="$2"
  local entry="{\"ts\":\"${TS}\",\"level\":\"${level}\",\"event\":\"GIT_${msg}\",\"proc\":\"git-pre-commit\",\"user\":\"$(id -un)\",\"pid\":$$}"
  echo "$entry" >> "$ARMOR_LOG" 2>/dev/null || true
  echo "[SENTINEL][${level}] GIT PRE-COMMIT: ${msg}" >&2
}

# ── Allow CLAUDE_MAIN_AGENT_v1 ────────────────────────────────────────────
if [[ "$AGENT_TOKEN" == "CLAUDE_MAIN_AGENT_v1" ]]; then
  log_alert "INFO" "AUTHORIZED_AGENT_COMMIT"
  exit 0
fi

# ── Block non-interactive (automated) commits ─────────────────────────────
# A real human commit always has a TTY stdin
if [[ ! -t 0 ]] && [[ ! -t 1 ]]; then
  log_alert "CRITICAL" "BLOCKED_NON_INTERACTIVE_COMMIT — no TTY detected"
  wall "[SENTINEL ALERT] BLOCKED: automated git commit attempted by $(id -un) (PID:$$)" 2>/dev/null || true
  echo "" >&2
  echo "╔══════════════════════════════════════════════════════════╗" >&2
  echo "║  SENTINEL: COMMIT BLOCKED — non-interactive session      ║" >&2
  echo "║  Only human (TTY) or CLAUDE_MAIN_AGENT_v1 may commit.   ║" >&2
  echo "╚══════════════════════════════════════════════════════════╝" >&2
  exit 1
fi

# ── Block commits with [auto] or [bot] in GIT_AUTHOR_NAME ─────────────────
AUTHOR="${GIT_AUTHOR_NAME:-}"
if echo "$AUTHOR" | grep -qiE '\[auto\]|\[bot\]|autocommit|autopush'; then
  log_alert "CRITICAL" "BLOCKED_AUTO_AUTHOR: ${AUTHOR}"
  echo "SENTINEL: Blocked commit from automated author: ${AUTHOR}" >&2
  exit 1
fi

# ── Block if called from known auto-trigger scripts ───────────────────────
PARENT_CMD=$(ps -o comm= -p $PPID 2>/dev/null || echo "unknown")
if echo "$PARENT_CMD" | grep -qiE 'autocommit|autopush|cron|systemd-run|at$'; then
  log_alert "CRITICAL" "BLOCKED_AUTO_PARENT_PROCESS: ${PARENT_CMD}"
  echo "SENTINEL: Blocked commit triggered by: ${PARENT_CMD}" >&2
  exit 1
fi

# ── Check for forbidden auto-files being committed ───────────────────────
STAGED=$(git diff --cached --name-only 2>/dev/null)
FORBIDDEN_PATTERNS=("scripts/autocommit.sh" "scripts/autofix.sh" ".env.production" ".armor/")
for pattern in "${FORBIDDEN_PATTERNS[@]}"; do
  if echo "$STAGED" | grep -q "$pattern"; then
    log_alert "WARNING" "SENSITIVE_FILE_STAGED: ${pattern}"
    echo "SENTINEL WARNING: Sensitive file staged: ${pattern}" >&2
    echo "Proceed? (y/N): " >&2
    read -r confirm < /dev/tty
    if [[ "${confirm,,}" != "y" ]]; then
      log_alert "INFO" "COMMIT_ABORTED_BY_USER"
      exit 1
    fi
  fi
done

log_alert "INFO" "COMMIT_AUTHORIZED_HUMAN: $(id -un)"
exit 0
