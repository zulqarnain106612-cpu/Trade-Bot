# .claudeignore — Claude Desktop + Claude Code never read these
# Rule: if it's not in CLAUDE.md's module map, it burns tokens for nothing.

# Runtime data — never source of truth
data/
logs/
models/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.coverage
.coverage_floors_tmp.json

# Node
node_modules/

# Project-intel — large, stale, superseded by CLAUDE.md
.project-intel/

# Secrets — never read
.env

# Git internals
.git/

# Frontend build output
frontend/dist/
frontend/build/

# Lock files (too large, not useful for tasks)
requirements.lock

# DB files
*.db
*.wal

# CI artifacts
check_runs.json
ci_jobs.json
