# .claudeignore — Claude Desktop + Claude Code never read these
# Rule: if it's not in CLAUDE.md's module map, it burns tokens for nothing.

# Runtime data — never source of truth
data/
logs/
models/

# Python artifacts
__pycache__/
*.pyc
*.pyo
.venv/
.mypy_cache/
.coverage
.coverage_floors_tmp.json

# Node
node_modules/

# Secrets — never read
.env

# Git internals
.git/

# Frontend build output
frontend/dist/
frontend/build/

# Lock files (too large, not useful for tasks)
requirements.lock

# DB files
*.db
*.wal

# CI artifacts
check_runs.json
ci_jobs.json

# === enforcement-additions ===
# .claude/worktrees/ = full src duplicate (agent worktrees).
# Harness indexes this path → re-injects all files on git ops.
.claude/worktrees/
# Hook scripts: executable files, not source of truth
.claude/hooks/
# Session tracker files (auto-cleaned by OS, never source of truth)
.claude_signals/
.claude_probe
