#!/usr/bin/env bash
# Lint → type-check → test → commit with conventional message
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$PROJECT_ROOT"

if [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi

echo "=== Pre-commit pipeline ==="

echo "[1/3] Ruff lint + fix..."
uv run ruff check --fix src/ || { echo "FAIL: ruff"; exit 1; }

echo "[2/3] Mypy type check..."
uv run mypy src/ --no-error-summary || { echo "FAIL: mypy"; exit 1; }

echo "[3/3] Pytest..."
uv run pytest tests/ -x -q || { echo "FAIL: pytest"; exit 1; }

echo ""
echo "All checks passed."

if [ -z "$(git diff --cached --name-only)" ]; then
  echo "Nothing staged. Stage with: git add <files>"
  exit 0
fi

if [ -n "$1" ]; then
  MSG="$*"
else
  echo "Commit message (conventional format — e.g. 'feat(strategy): add RSI filter'):"
  read -r MSG
fi

git commit -m "$MSG"
echo "Committed: $MSG"
