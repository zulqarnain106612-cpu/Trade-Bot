#!/usr/bin/env bash
# Start an aider session with Trade-Bot-main config
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
CONFIG="$PROJECT_ROOT/.ai/configs/aider.conf.yml"
SESSION_DIR="$PROJECT_ROOT/.ai/sessions"
LOG_DIR="$PROJECT_ROOT/.ai/logs"

mkdir -p "$SESSION_DIR" "$LOG_DIR"

SESSION_ID="$(date +%Y%m%d-%H%M%S)"
LOG_FILE="$LOG_DIR/aider-$SESSION_ID.log"

echo "=== Aider Session $SESSION_ID ==="
echo "Config: $CONFIG"
echo "Log:    $LOG_FILE"
echo ""

cd "$PROJECT_ROOT"

# Activate venv if available
if [ -f ".venv/bin/activate" ]; then
  source .venv/bin/activate
fi

exec aider \
  --config "$CONFIG" \
  --input-history-file "$SESSION_DIR/history-$SESSION_ID" \
  "$@" 2>&1 | tee "$LOG_FILE"
