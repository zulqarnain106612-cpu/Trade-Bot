#!/usr/bin/env bash
# Run full lint suite: ruff + mypy
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$PROJECT_ROOT"

if [ -f ".venv/bin/activate" ]; then source .venv/bin/activate; fi

TARGET="${1:-src/}"
echo "=== Lint: $TARGET ==="

echo "[ruff]"
uv run ruff check --fix "$TARGET"

echo "[mypy]"
uv run mypy "$TARGET" --no-error-summary

echo "All lint passed."
