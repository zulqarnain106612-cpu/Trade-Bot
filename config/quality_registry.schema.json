{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/zulqarnain106612-cpu/Trade-Bot/config/quality_registry.schema.json",
  "title": "Trade-Bot quality and security requirements registry",
  "description": "Structural contract for config/quality_registry.json. Shape only -- the cross-entry rules (dangling depends_on, a 'verified' entry naming a test that is not on disk, a critical entry with no owner) live in src/quality/registry.py, because JSON Schema cannot express them.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "kind_definitions",
    "status_definitions",
    "criticality_definitions",
    "test_types",
    "subsystems",
    "phases",
    "entries"
  ],
  "properties": {
    "registry_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind_definitions": {
      "type": "object",
      "description": "What each kind of entry asserts. An id prefix is bound to a kind by the loader.",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "status_definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "criticality_definitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 10 }
    },
    "test_types": {
      "type": "object",
      "description": "The test taxonomy of docs/quality/TEST_STRATEGY.md: type -> the question it answers.",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 5 }
    },
    "subsystems": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
    },
    "phases": {
      "type": "object",
      "description": "PR-NNN -> the phase title it delivers. Every planned entry names one of these.",
      "minProperties": 1,
      "propertyNames": { "pattern": "^PR-[0-9]{3}$" },
      "additionalProperties": { "type": "string", "minLength": 5 }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "statement",
        "criticality",
        "subsystem",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(INV-[0-9]{3}|REG-[0-9]{4}|SEC-[0-9]{4}|[A-Z]{3,5}-[0-9]{3})$"
        },
        "kind": { "type": "string", "minLength": 3 },
        "title": { "type": "string", "minLength": 5, "maxLength": 120 },
        "statement": {
          "type": "string",
          "minLength": 20,
          "description": "The requirement as a testable proposition, not a slogan."
        },
        "criticality": { "type": "string", "minLength": 3 },
        "subsystem": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "status": { "type": "string", "minLength": 3 },
        "source": {
          "type": "string",
          "description": "Section of docs/Quality-Engineering this entry comes from, e.g. 'QE-42'.",
          "pattern": "^QE-[0-9]{1,2}(,QE-[0-9]{1,2})*$"
        },
        "owning_modules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3 }
        },
        "verification": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/verification" }
        },
        "planned_in": { "type": "string", "pattern": "^PR-[0-9]{3}$" },
        "waiver": { "$ref": "#/definitions/waiver" },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(INV-[0-9]{3}|REG-[0-9]{4}|SEC-[0-9]{4}|[A-Z]{3,5}-[0-9]{3})$"
          }
        },
        "failure_mode": {
          "type": "string",
          "description": "What goes wrong in production if this requirement is violated."
        },
        "notes": { "type": "string" }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test", "test_type"],
      "properties": {
        "test": {
          "type": "string",
          "description": "Repo-relative path to a test file, optionally ::-qualified to a node.",
          "pattern": "^tests/[A-Za-z0-9_/]+\\.py(::[A-Za-z0-9_:]+)?$"
        },
        "test_type": { "type": "string", "minLength": 3 },
        "note": { "type": "string" }
      }
    },
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "accepted_by", "review_by"],
      "properties": {
        "reason": { "type": "string", "minLength": 20 },
        "accepted_by": { "type": "string", "minLength": 2 },
        "review_by": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "ISO date. A waiver with no expiry is a permanent hole."
        }
      }
    }
  }
}
