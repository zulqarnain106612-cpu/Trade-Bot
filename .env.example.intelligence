# .env.example.intelligence
# Intelligence provider onboarding template — placeholders only. DO NOT commit secrets.
# Copy needed keys into your runtime secret store or local .env when testing.

# Provider API keys (leave empty when not used)
INTELLIGENCE_GLASSNODE_API_KEY=
INTELLIGENCE_CRYPTOQUANT_API_KEY=
INTELLIGENCE_ARKHAM_API_KEY=
INTELLIGENCE_DUNE_API_KEY=
INTELLIGENCE_COINGLASS_API_KEY=
INTELLIGENCE_DEFILLAMA_API_KEY=

# Provider cache / rate tuning (seconds)
INTELLIGENCE_ARKHAM_CACHE_TTL_S=60
INTELLIGENCE_DEFILLAMA_CACHE_TTL_S=300
INTELLIGENCE_DUNE_CACHE_TTL_S=3600
INTELLIGENCE_COINGLASS_CACHE_TTL_S=30

# Glassnode specifics
INTELLIGENCE_GLASSNODE_BASE_URL=https://api.glassnode.com/v1/metrics
INTELLIGENCE_GLASSNODE_RATE_LIMIT_SECONDS=1.0

# Global intelligence caching windows (seconds)
INTELLIGENCE_CACHE_TTL_ONCHAIN_SECONDS=3600
INTELLIGENCE_CACHE_TTL_EXCHANGE_SECONDS=300

# Optional feature/behaviour toggles (examples)
# When set to true/false, these may enable/disable certain intelligence behaviours.
INTELLIGENCE_ENABLE_ONCHAIN=true
INTELLIGENCE_ENABLE_EXCHANGE=true

# Notes:
# - These are example placeholders only. Populate only the keys you need for the
#   providers you intend to enable. Keep paid-provider keys in a secure secret
#   manager and never commit real secrets to the repository.
# - The application uses Pydantic Settings with env_prefix="INTELLIGENCE_" — keys
#   above map directly to fields in src/config.py (IntelligenceSettings).
